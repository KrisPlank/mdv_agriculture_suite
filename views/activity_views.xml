<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_agri_activity_list" model="ir.ui.view">
        <field name="name">mdv.agri.activity.list</field>
        <field name="model">mdv.agri.activity</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'" decoration-danger="is_overdue">
                <field name="date_planned"/>
                <field name="name"/>
                <field name="activity_type"/>
                <field name="plan_id"/>
                <field name="field_id"/>
                <field name="crop_id" optional="show"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="date_done" optional="show"/>
                <field name="total_cost" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="is_overdue" column_invisible="1"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state == 'planned'"/>
            </list>
        </field>
    </record>

    <record id="view_agri_activity_kanban" model="ir.ui.view">
        <field name="name">mdv.agri.activity.kanban</field>
        <field name="model">mdv.agri.activity</field>
        <field name="arch" type="xml">
            <kanban default_group_by="activity_type">
                <field name="color"/>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold"/>
                        <div><field name="field_id"/> - <field name="crop_id"/></div>
                        <div class="text-muted small"><field name="date_planned"/></div>
                        <footer>
                            <field name="state" widget="label_selection" options="{'classes': {'planned': 'info', 'done': 'success', 'cancelled': 'default'}}"/>
                            <field name="user_id" widget="many2one_avatar_user" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_agri_activity_calendar" model="ir.ui.view">
        <field name="name">mdv.agri.activity.calendar</field>
        <field name="model">mdv.agri.activity</field>
        <field name="arch" type="xml">
            <calendar date_start="date_planned" color="activity_type" mode="month" string="Field Work Calendar" quick_create="0">
                <field name="field_id"/>
                <field name="crop_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="view_agri_activity_form" model="ir.ui.view">
        <field name="name">mdv.agri.activity.form</field>
        <field name="model">mdv.agri.activity</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_done" type="object" string="Mark as Done" class="btn-primary" invisible="state != 'planned'"/>
                    <button name="action_reset" type="object" string="Undo" invisible="state != 'done'" groups="mdv_agriculture_suite.group_agri_manager"
                            confirm="The consumed stock is returned and the cost entries are removed. Continue?"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state != 'planned'"/>
                    <field name="state" widget="statusbar" statusbar_visible="planned,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_moves" type="object" class="oe_stat_button" icon="fa-truck" string="Stock Moves" invisible="not move_ids"/>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Top dressing nitrogen" readonly="state != 'planned'"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="activity_type" readonly="state != 'planned'"/>
                            <field name="plan_id" readonly="state != 'planned'"/>
                            <field name="field_id"/>
                            <field name="crop_id"/>
                            <field name="scouting_id" invisible="not scouting_id"/>
                        </group>
                        <group>
                            <field name="date_planned" readonly="state != 'planned'"/>
                            <field name="date_done" readonly="state != 'planned'"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="mdv_agri_imperial_units" invisible="1"/>
                            <field name="water_m3" invisible="activity_type != 'irrigation' or mdv_agri_imperial_units" readonly="state != 'planned'"/>
                            <field name="water_us_gal" string="Water (US gal)" invisible="activity_type != 'irrigation' or not mdv_agri_imperial_units" readonly="state != 'planned'"/>
                            <field name="weather_log_id" invisible="not weather_log_id"/>
                            <field name="total_cost"/>
                            <field name="move_ids" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Materials" name="materials">
                            <field name="material_line_ids" readonly="state != 'planned'">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="mdv_agri_imperial_units" column_invisible="1"/>
                                    <field name="rate_per_ha" invisible="mdv_agri_imperial_units"/>
                                    <field name="rate_per_acre" string="Rate per acre" invisible="not mdv_agri_imperial_units"/>
                                    <field name="unit_cost"/>
                                </list>
                            </field>
                        </page>
                        <page string="Labour" name="labour">
                            <group>
                                <field name="planned_labour_hours"/>
                            </group>
                            <field name="labour_line_ids" readonly="state != 'planned'">
                                <list editable="bottom">
                                    <field name="employee_id"/>
                                    <field name="hours" sum="Total"/>
                                    <field name="hourly_cost"/>
                                    <field name="amount" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Machinery" name="machinery">
                            <group>
                                <field name="planned_machine_hours"/>
                            </group>
                            <field name="machine_line_ids" readonly="state != 'planned'">
                                <list editable="bottom">
                                    <field name="equipment_id"/>
                                    <field name="operator_id"/>
                                    <field name="hours" sum="Total"/>
                                    <field name="hourly_rate"/>
                                    <field name="amount" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Costs" name="costs" invisible="state != 'done'">
                            <field name="cost_line_ids" readonly="1">
                                <list>
                                    <field name="cost_type"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="unit_label"/>
                                    <field name="unit_cost"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_agri_activity_search" model="ir.ui.view">
        <field name="name">mdv.agri.activity.search</field>
        <field name="model">mdv.agri.activity</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="plan_id"/>
                <field name="field_id"/>
                <field name="crop_id"/>
                <filter name="planned" string="To Do" domain="[('state', '=', 'planned')]"/>
                <filter name="overdue" string="Overdue" domain="[('is_overdue', '=', True)]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="my" string="My Activities" domain="[('user_id', '=', uid)]"/>
                <group>
                    <filter name="group_type" string="Type" context="{'group_by': 'activity_type'}"/>
                    <filter name="group_field" string="Field" context="{'group_by': 'field_id'}"/>
                    <filter name="group_plan" string="Crop Plan" context="{'group_by': 'plan_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_agri_activity" model="ir.actions.act_window">
        <field name="name">Field Activities</field>
        <field name="res_model">mdv.agri.activity</field>
        <field name="view_mode">list,kanban,calendar,form</field>
        <field name="context">{'search_default_planned': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No field work planned</p>
            <p>Activities consume seed, fertiliser and chemicals from the farm stock and log labour and machine hours into the job cost sheet.</p>
        </field>
    </record>

    <!-- Cost entries and budget vs actual -->
    <record id="view_agri_cost_line_list" model="ir.ui.view">
        <field name="name">mdv.agri.cost.line.list</field>
        <field name="model">mdv.agri.cost.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="date"/>
                <field name="cost_type"/>
                <field name="name"/>
                <field name="plan_id" optional="show"/>
                <field name="herd_id" optional="show"/>
                <field name="activity_id" optional="hide"/>
                <field name="field_id" optional="hide"/>
                <field name="quantity"/>
                <field name="unit_label"/>
                <field name="unit_cost"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_agri_cost_line_pivot" model="ir.ui.view">
        <field name="name">mdv.agri.cost.line.pivot</field>
        <field name="model">mdv.agri.cost.line</field>
        <field name="arch" type="xml">
            <pivot string="Farm Costs" sample="1">
                <field name="farm_id" type="row"/>
                <field name="cost_type" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_agri_cost_line_search" model="ir.ui.view">
        <field name="name">mdv.agri.cost.line.search</field>
        <field name="model">mdv.agri.cost.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="plan_id"/>
                <field name="herd_id"/>
                <field name="farm_id"/>
                <filter name="crops" string="Crops" domain="[('plan_id', '!=', False)]"/>
                <filter name="livestock" string="Livestock" domain="[('herd_id', '!=', False)]"/>
                <group>
                    <filter name="group_type" string="Cost Type" context="{'group_by': 'cost_type'}"/>
                    <filter name="group_plan" string="Crop Plan" context="{'group_by': 'plan_id'}"/>
                    <filter name="group_herd" string="Herd" context="{'group_by': 'herd_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_agri_cost_line" model="ir.actions.act_window">
        <field name="name">Farm Costs</field>
        <field name="res_model">mdv.agri.cost.line</field>
        <field name="view_mode">list,pivot</field>
    </record>

    <record id="view_agri_cost_report_pivot" model="ir.ui.view">
        <field name="name">mdv.agri.cost.report.pivot</field>
        <field name="model">mdv.agri.cost.report</field>
        <field name="arch" type="xml">
            <pivot string="Budget vs Actual" sample="1">
                <field name="crop_id" type="row"/>
                <field name="cost_type" type="col"/>
                <field name="budget_amount" type="measure"/>
                <field name="actual_amount" type="measure"/>
                <field name="variance" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_agri_cost_report_graph" model="ir.ui.view">
        <field name="name">mdv.agri.cost.report.graph</field>
        <field name="model">mdv.agri.cost.report</field>
        <field name="arch" type="xml">
            <graph string="Budget vs Actual" type="bar" sample="1">
                <field name="plan_id"/>
                <field name="budget_amount" type="measure"/>
                <field name="actual_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_agri_cost_report_search" model="ir.ui.view">
        <field name="name">mdv.agri.cost.report.search</field>
        <field name="model">mdv.agri.cost.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="plan_id"/>
                <field name="crop_id"/>
                <field name="season_id"/>
                <field name="field_id"/>
                <group>
                    <filter name="group_season" string="Season" context="{'group_by': 'season_id'}"/>
                    <filter name="group_farm" string="Farm" context="{'group_by': 'farm_id'}"/>
                    <filter name="group_field" string="Field" context="{'group_by': 'field_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_agri_cost_report" model="ir.actions.act_window">
        <field name="name">Budget vs Actual</field>
        <field name="res_model">mdv.agri.cost.report</field>
        <field name="view_mode">pivot,graph</field>
    </record>
</odoo>
