<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_crop_plan" model="ir.sequence">
            <field name="name">mdv.agri.crop.plan</field>
            <field name="code">mdv.agri.crop.plan</field>
            <field name="prefix">CP/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_harvest" model="ir.sequence">
            <field name="name">mdv.agri.harvest</field>
            <field name="code">mdv.agri.harvest</field>
            <field name="prefix">HV/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_scouting" model="ir.sequence">
            <field name="name">mdv.agri.scouting</field>
            <field name="code">mdv.agri.scouting</field>
            <field name="prefix">SC/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_crop_request" model="ir.sequence">
            <field name="name">mdv.agri.crop.request</field>
            <field name="code">mdv.agri.crop.request</field>
            <field name="prefix">CR/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_vet_treatment" model="ir.sequence">
            <field name="name">mdv.agri.vet.treatment</field>
            <field name="code">mdv.agri.vet.treatment</field>
            <field name="prefix">VT/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_breeding" model="ir.sequence">
            <field name="name">mdv.agri.breeding</field>
            <field name="code">mdv.agri.breeding</field>
            <field name="prefix">BR/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="cron_weather" model="ir.cron">
            <field name="name">Agriculture: fetch farm weather (Open-Meteo)</field>
            <field name="model_id" ref="model_mdv_agri_weather_log"/>
            <field name="state">code</field>
            <field name="code">model._cron_fetch_weather()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_vaccination" model="ir.cron">
            <field name="name">Agriculture: plan due vaccinations</field>
            <field name="model_id" ref="model_mdv_agri_vaccination_schedule"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_vaccinations()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_breeding" model="ir.cron">
            <field name="name">Agriculture: pregnancy checks and births due</field>
            <field name="model_id" ref="model_mdv_agri_breeding"/>
            <field name="state">code</field>
            <field name="code">model._cron_breeding_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_plans" model="ir.cron">
            <field name="name">Agriculture: start sown crop plans</field>
            <field name="model_id" ref="model_mdv_agri_crop_plan"/>
            <field name="state">code</field>
            <field name="code">model._cron_start_due_plans()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <record id="grade_a" model="mdv.agri.quality.grade">
            <field name="name">Grade A</field>
            <field name="code">A</field>
            <field name="sequence">10</field>
            <field name="price_factor">1.0</field>
        </record>
        <record id="grade_b" model="mdv.agri.quality.grade">
            <field name="name">Grade B</field>
            <field name="code">B</field>
            <field name="sequence">20</field>
            <field name="price_factor">0.85</field>
        </record>
        <record id="grade_c" model="mdv.agri.quality.grade">
            <field name="name">Grade C / Feed</field>
            <field name="code">C</field>
            <field name="sequence">30</field>
            <field name="price_factor">0.6</field>
        </record>
        <record id="soil_loam" model="mdv.agri.soil.type">
            <field name="name">Loam</field>
            <field name="texture">loam</field>
            <field name="drainage">good</field>
        </record>
        <record id="soil_clay_loam" model="mdv.agri.soil.type">
            <field name="name">Clay Loam</field>
            <field name="texture">clay</field>
            <field name="drainage">moderate</field>
        </record>
        <record id="soil_sandy_loam" model="mdv.agri.soil.type">
            <field name="name">Sandy Loam</field>
            <field name="texture">sand</field>
            <field name="drainage">good</field>
        </record>
        <record id="soil_silt_loam" model="mdv.agri.soil.type">
            <field name="name">Silt Loam</field>
            <field name="texture">silt</field>
            <field name="drainage">moderate</field>
        </record>
        <record id="soil_heavy_clay" model="mdv.agri.soil.type">
            <field name="name">Heavy Clay</field>
            <field name="texture">clay</field>
            <field name="drainage">poor</field>
        </record>
        <record id="species_cattle" model="mdv.agri.animal.species">
            <field name="name">Cattle</field>
            <field name="kind">cattle</field>
            <field name="gestation_days">283</field>
            <field name="produces_milk" eval="True"/>
            <field name="produces_eggs" eval="False"/>
        </record>
        <record id="species_poultry" model="mdv.agri.animal.species">
            <field name="name">Chicken</field>
            <field name="kind">poultry</field>
            <field name="gestation_days">21</field>
            <field name="produces_milk" eval="False"/>
            <field name="produces_eggs" eval="True"/>
        </record>
        <record id="species_goat" model="mdv.agri.animal.species">
            <field name="name">Goat</field>
            <field name="kind">goat</field>
            <field name="gestation_days">150</field>
            <field name="produces_milk" eval="True"/>
            <field name="produces_eggs" eval="False"/>
        </record>
        <record id="species_sheep" model="mdv.agri.animal.species">
            <field name="name">Sheep</field>
            <field name="kind">sheep</field>
            <field name="gestation_days">147</field>
            <field name="produces_milk" eval="False"/>
            <field name="produces_eggs" eval="False"/>
        </record>
        <record id="species_pig" model="mdv.agri.animal.species">
            <field name="name">Pig</field>
            <field name="kind">pig</field>
            <field name="gestation_days">114</field>
            <field name="produces_milk" eval="False"/>
            <field name="produces_eggs" eval="False"/>
        </record>
    </data>
</odoo>
