    <record id="rule_season_company" model="ir.rule">
        <field name="name">season: own companies</field>
        <field name="model_id" ref="model_mdv_agri_season"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_crop_request_portal" model="ir.rule">
        <field name="name">crop request: portal sees own</field>
        <field name="model_id" ref="model_mdv_agri_crop_request"/>
        <field name="domain_force">[('partner_id', 'child_of', [user.partner_id.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>
</odoo>
