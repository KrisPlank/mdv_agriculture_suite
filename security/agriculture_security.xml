<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_agriculture" model="ir.module.category">
        <field name="name">Agriculture</field>
        <field name="sequence">45</field>
    </record>
    <record id="privilege_agriculture" model="res.groups.privilege">
        <field name="name">Agriculture</field>
        <field name="category_id" ref="module_category_agriculture"/>
        <field name="sequence">10</field>
    </record>
    <record id="group_agri_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_agriculture"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('stock.group_stock_user'))]"/>
        <field name="comment">Records field activities, scouting, harvests, weather, milk, eggs, feed and vet treatments.</field>
    </record>
    <record id="group_agri_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_agriculture"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('group_agri_user')), (4, ref('sales_team.group_sale_salesman')), (4, ref('purchase.group_purchase_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Configures crops, seasons, pests and schedules, approves crop requests, sees costs and deletes records.</field>
    </record>

    <record id="rule_farm_company" model="ir.rule">
        <field name="name">farm: own companies</field>
        <field name="model_id" ref="model_mdv_agri_farm"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_field_company" model="ir.rule">
        <field name="name">field: own companies</field>
        <field name="model_id" ref="model_mdv_agri_field"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_soil_test_company" model="ir.rule">
