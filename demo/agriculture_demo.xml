    <record id="pest_aphid" model="mdv.agri.pest">
        <field name="name">Aphids</field>
        <field name="pest_type">insect</field>
        <field name="scientific_name">Aphidoidea</field>
        <field name="symptoms">Curled leaves, honeydew, colonies under leaves.</field>
        <field name="threshold">15 aphids per tiller before heading</field>
        <field name="recommendation">Spray pyrethrin when the threshold is reached; keep beneficial insects.</field>
        <field name="treatment_line_ids" eval="[(0, 0, {'product_id': ref('prod_insecticide'), 'rate_per_ha': 0.4})]"/>
    </record>
    <record id="pest_rust" model="mdv.agri.pest">
        <field name="name">Wheat Leaf Rust</field>
        <field name="pest_type">disease</field>
        <field name="scientific_name">Puccinia triticina</field>
        <field name="symptoms">Orange-brown pustules on leaves.</field>
        <field name="threshold">First pustules on flag leaf -1</field>
        <field name="recommendation">Apply copper fungicide; resistant varieties next season.</field>
        <field name="treatment_line_ids" eval="[(0, 0, {'product_id': ref('prod_fungicide'), 'rate_per_ha': 1.0})]"/>
    </record>
    <record id="pest_nclb" model="mdv.agri.pest">
        <field name="name">Northern Corn Leaf Blight</field>
        <field name="pest_type">disease</field>
        <field name="scientific_name">Exserohilum turcicum</field>
        <field name="symptoms">Long grey-green lesions on lower leaves.</field>
        <field name="threshold">Lesions on the third leaf below the ear before tasseling</field>
        <field name="recommendation">Fungicide at VT-R1; rotate crops; bury residue.</field>
        <field name="treatment_line_ids" eval="[(0, 0, {'product_id': ref('prod_fungicide'), 'rate_per_ha': 1.2})]"/>
    </record>
    <record id="pest_blight" model="mdv.agri.pest">
        <field name="name">Tomato Late Blight</field>
        <field name="pest_type">disease</field>
        <field name="scientific_name">Phytophthora infestans</field>
        <field name="symptoms">Dark water-soaked spots, white mould under leaves.</field>
        <field name="threshold">Any lesion in wet weather</field>
        <field name="recommendation">Copper fungicide every 7 days in wet weather; remove infected plants.</field>
        <field name="treatment_line_ids" eval="[(0, 0, {'product_id': ref('prod_fungicide'), 'rate_per_ha': 1.5})]"/>
    </record>
    <record id="pest_waterhemp" model="mdv.agri.pest">
        <field name="name">Waterhemp</field>
        <field name="pest_type">weed</field>
        <field name="scientific_name">Amaranthus tuberculatus</field>
        <field name="symptoms">Fast-growing broadleaf weed.</field>
        <field name="threshold">Weeds over 10 cm</field>
        <field name="recommendation">Post-emergence herbicide before weeds pass 10 cm.</field>
        <field name="treatment_line_ids" eval="[(0, 0, {'product_id': ref('prod_herbicide'), 'rate_per_ha': 2.0})]"/>
    </record>
